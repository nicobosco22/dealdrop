# Copy this file to ".env.local" and fill in the blanks.
# Never put real keys in this file: it is saved to GitHub. ".env.local" is not.

# --- Database ---
# Leave blank on your own computer: the app then uses a local database in the .data/ folder.
# When we put the app online, this becomes the Neon connection string.
DATABASE_URL=

# --- Data sources (added as each one is built) ---
# DealNews needs no key.

# Best Buy Products API: https://developer.bestbuy.com  (needs a non-Gmail email, e.g. your school one)
BESTBUY_API_KEY=

# eBay Browse API: https://developer.ebay.com  (create a "Production" keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Watchlist alerts (optional) ---
# Paste a Discord channel webhook here to get a message when a new deal matches your watchlist.
# In Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# Leave blank and nothing is sent; matches still show on the Watchlist page.
DISCORD_WEBHOOK_URL=

# --- Auto fetch ---
# While the app is running, fetch new deals every this many minutes (never faster than 5).
# 0 turns it off. Leave blank for the default of 15.
AUTO_FETCH_MINUTES=
