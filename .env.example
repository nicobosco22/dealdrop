# Copy this file to ".env.local" and fill in the blanks.
# Never put real keys in this file: it is saved to GitHub. ".env.local" is not.

# --- Database ---
# Leave blank on your own computer: the app then uses a local database in the .data/ folder.
# When we put the app online, this becomes the Neon connection string.
DATABASE_URL=

# --- Data sources (added as each one is built) ---
# DealNews needs no key.

# Best Buy Products API: https://developer.bestbuy.com  (needs a non-Gmail email, e.g. your school one)
BESTBUY_API_KEY=

# eBay Browse API: https://developer.ebay.com  (create a "Production" keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
